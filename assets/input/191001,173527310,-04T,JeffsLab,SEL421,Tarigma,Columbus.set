[PF]
"PROTO",SEL,SEL+MBA+MBB+RTD+PMU,I,,"Protocol (SEL,DNP,MBA,MBB,RTD,PMU)"
"MBT",N,N+Y,I,,"Using Pulsar 9600 modem? (Y,N)"
"SPEED",19200,300+600+1200+2400+4800+9600+19200+38400+57600,U,,"Data Speed (300 to 57600)"
"DATABIT",8,7+8,I,,"Data Bits (7,8 bits)"
"PARITY",N,N+E+O,I,,"Parity (Odd,Even,None)"
"STOPBIT",1,1+2,I,,"Stop Bits (1,2 bits)"
"RTSCTS",Y,N+Y,I,,"Enable Hardware Handshaking (Y,N)"
"TIMEOUT",OFF,1~60,C,"minutes","Port Time-Out (OFF,1-60 mins)"
"AUTO",N,N+Y,I,,"Send Auto-Messages to Port (Y,N)"
"FASTOP",N,N+Y,I,,"Enable Fast Operate Messages (Y,N)"
"TERTIM1",1,0~600,U,"seconds","Initial Delay -Disconnect Sequence (0-600 seconds)"
"TERSTRN","\005",,S,,"Termination String -Disconn. Sequence (9 char max)"
"TERTIM2",0,0~600,U,"seconds","Final Delay -Disconnect Sequence (0-600 seconds)"
"DNPADR",0,0~65534,U,,"DNP Address (0-65534)"
"ECLASSB",1,OFF+1+2+3,I,,"Class for Binary Event Data (OFF,1-3)"
"ECLASSC",OFF,OFF+1+2+3,I,,"Class for Counter Event Data (OFF,1-3)"
"ECLASSA",2,OFF+1+2+3,I,,"Class for Analog Event Data (OFF,1-3)"
"TIMERQ",I,1~32767,I,"minutes","Time-Set Request Interval (I,M,1-32767 mins)"
"DECPLA",1,0+1+2+3,I,,"Currents Scaling (0-3 decimal places)"
"DECPLV",1,0+1+2+3,I,,"Voltages Scaling (0-3 decimal places)"
"DECPLM",1,0+1+2+3,I,,"Misc Data Scaling (0-3 decimal places)"
"STIMEO",1.0,0~60,U,"seconds","Select/Operate Time-Out (0.0-60.0 seconds)"
"DRETRY",OFF,1~15,C,,"Data Link Retries (OFF,1-15)"
"DTIMEO",1.0,0~30,U,"seconds","Data Link Time-Out (0.0-30.0 seconds)"
"MINDLY",0.05,0~1,U,"seconds","Minimum Delay from DCD to TX (0.00-1.00 seconds)"
"MAXDLY",0.10,0~1,U,"seconds","Maximum Delay from DCD to TX (0.00-1.00 seconds)"
"PREDLY",0.00,0~30,U,"seconds","Settle Time -RTS On to TX (OFF,0.00-30.00 seconds)"
"PSTDLY",0.00,0~30,U,"seconds","Settle Time -TX to RTS Off (0.00-30.00 seconds)"
"ANADBA",100,0~32767,U,,"Analog Reporting Deadband for Currents (0-32767)"
"ANADBV",100,0~32767,U,,"Analog Reporting Deadband for Voltages (0-32767)"
"ANADBM",100,0~32767,U,,"Analog Reporting Deadband (0-32767)"
"ETIMEO",10.0,0~100,R,"seconds","Event Data Confirmation Time-Out (0.1-100.0 secs)"
"UNSOL",N,N+Y,I,,"Enable Unsolicited Reporting (Y,N)"
"PUNSOL",N,N+Y,I,,"Enable Unsolicited Reporting at Power-Up (Y,N)"
"REPADR",1,0~65534,U,,"DNP Address to Report to (0-65534)"
"NUMEVE",10,1~200,U,,"Number of Events to Transmit On (1-200)"
"AGEEVE",2.0,0~60,U,"seconds","Age of Oldest Event to Transmit On (0.0-60.0 secs)"
"MODEM",N,N+Y,I,,"Modem Connected to Port (Y,N)"
"MSTR","E0X0&D0S0=4",,S,,"Modem Startup String (30 chars max)"
"PH_NUM","",,S,,"Phone Number for Dial-Out (30 chars max)"
"MDTIME",60,5~300,U,,"Time to Attempt Dial (5-300 seconds)"
"MDRET",120,5~3600,U,"seconds","Time Between Dial-Out Attempts (5-3600 seconds)"
"TX_ID",2,1+2+3+4,I,,"Mirrored Bits ID of This Device (1-4)"
"RX_ID",1,1+2+3+4,I,,"Mirrored Bits ID of Device Receiving From (1-4)"
"RBADPU",10,1~10000,U,"seconds","Outage Duration to Set RBAD (1-10000 seconds)"
"CBADPU",20000,1~100000,R,"ppm","Channel Unavailability to Set CBAD (1-100000 ppm)"
"TXMODE",N,N+P,I,,"Transmission Mode (N-Normal,P-Paced)"
"MBNUM",4,0+1+2+3+4+5+6+7+8,I,,"Number of Mirrored Bits Channels (0-8)"
"RMB1FL",P,0+1+P,I,,"RMB1 Channel Fail State (0,1,P)"
"RMB1PU",1,1+2+3+4+5+6+7+8,I,,"RMB1 Pickup Time (1-8 messages)"
"RMB1DO",1,1+2+3+4+5+6+7+8,I,,"RMB1 Dropout Time (1-8 messages)"
"RMB2FL",P,0+1+P,I,,"RMB2 Channel Fail State (0,1,P)"
"RMB2PU",1,1+2+3+4+5+6+7+8,I,,"RMB2 Pickup Time (1-8 messages)"
