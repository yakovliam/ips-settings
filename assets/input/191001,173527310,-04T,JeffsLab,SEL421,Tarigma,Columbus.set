[L2]
"PROTSEL1","#*************************** PH TO PH VOLTAGE CALC ************************"
"PROTSEL2","PMV01 := VAFIM * COS(VAFIA) - VBFIM * COS(VBFIA) # LINE VAB REAL"
"PROTSEL3","PMV02 := VAFIM * SIN(VAFIA) - VBFIM * SIN(VBFIA) # LINE VAB IMAGINARY"
"PROTSEL4","PMV03 := SQRT(PMV01 * PMV01 + PMV02 * PMV02) # LINE VAB MAGNITUDE"
"PROTSEL5","PMV04 := VBFIM * COS(VBFIA) - VCFIM * COS(VCFIA) # LINE VBC REAL"
"PROTSEL6","PMV05 := VBFIM * SIN(VBFIA) - VCFIM * SIN(VCFIA) # LINE VBC IMAGINARY"
"PROTSEL7","PMV06 := SQRT(PMV04 * PMV04 + PMV05 * PMV05) # LINE VBC MAGNITUDE"
"PROTSEL8","PMV07 := VCFIM * COS(VCFIA) - VAFIM * COS(VAFIA) # LINE VCA REAL"
"PROTSEL9","PMV08 := VCFIM * SIN(VCFIA) - VAFIM * SIN(VAFIA) # LINE VCA IMAGINARY"
"PROTSEL10","PMV09 := SQRT(PMV07 * PMV07 + PMV08 * PMV08) # LINE VCA MAGNITUDE"
"PROTSEL11","# UNDERVOLTAGE ELEMENTS"
"PROTSEL12","PSV03 := PMV03 < AMV001 # VAB UNDERVOLTAGE ELEMENT"
"PROTSEL13","PSV06 := PMV06 < AMV001 # VBC UNDERVOLTAGE ELEMENT"
"PROTSEL14","PSV09 := PMV09 < AMV001 # VCA UNDERVOLTAGE ELEMENT"
"PROTSEL15","PCT01PU := AMV002 # UNDERVOLTAGE TRIP TIME DELAY"
"PROTSEL16","PCT01DO := 0.000000"
"PROTSEL17","PCT01IN := (PSV03 OR PSV06 OR PSV09) AND NOT LOP # TIME DELAY FOR ANY"
