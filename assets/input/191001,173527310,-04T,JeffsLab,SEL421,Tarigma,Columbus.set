[L3]
"PROTSEL1","# OSCILLOGRAPHY TRIGGERING"
"PROTSEL2","PLT01S := VAFIM <= 53.000000 # PHASE 1 UV OSC TRIGGER"
"PROTSEL3","PLT01R := VAFIM >= 56.000000 # RESET PHASE 1 UV TRIGGER"
"PROTSEL4","PLT03S := VBFIM <= 53.000000 # PHASE 2 UV TRIGGER"
"PROTSEL5","PLT03R := VBFIM >= 56.000000 # RESET PHASE 2 UV TRIGGER"
"PROTSEL6","PLT05S := VCFIM <= 53.000000 # PHASE 3 UV TRIGGER"
"PROTSEL7","PLT05R := VCFIM >= 56.000000 # RESET PHASE 3 UV TRIGGER"
"PROTSEL8","PLT08S := IPFIM >= 1.000000 # POLARIZING CURRENT TRIGGER"
"PROTSEL9","PLT08R := IPFIM <= 0.950000 # POLARIZING CURRENT TRIGGER"
"PROTSEL10","PCT06PU := 0.000000"
"PROTSEL11","PCT06DO := 10.000000"
"PROTSEL12","PCT06IN := R_TRIG RB06 OR R_TRIG LB01 OR R_TRIG PLT01 OR R_TRIG PLT03 OR R_TRIG PLT05 OR R_TRIG PLT08"
"PROTSEL13","PLT16S := ER OR R_TRIG TRIP"
"PROTSEL14","PLT16R := RB10"
"PROTSEL15","PCN01PV := 1000.000000"
"PROTSEL16","PCN01R := PCN01Q"
"PROTSEL17","PCN01IN := ER OR R_TRIG TRIP"
"PROTSEL18","PMV32 := PCN01CV"
"PROTSEL19","# CC2 CHECKBACK"
"PROTSEL20","PCT03PU := 0.000000"
"PROTSEL21","PCT03DO := 60.000000"
"PROTSEL22","PCT03IN := R_TRIG LB03"
"PROTSEL23","PSV04 := PCT03Q # UCA HMI STATUS"
"PROTSEL24","# CC2 LOOPBACK"
"PROTSEL25","PCT04PU := 0.000000"
"PROTSEL26","PCT04DO := 300.000000"
"PROTSEL27","PCT04IN := R_TRIG LB04 OR ASV024"
"PROTSEL28","PSV07 := PCT04Q # UCA HMI STATUS"
"PROTSEL29","# CC2 ALARM RESET"
"PROTSEL30","PCT05PU := 0.000000"
"PROTSEL31","PCT05DO := 480.000000"
"PROTSEL32","PCT05IN := R_TRIG LB05"
"PROTSEL33","PCT08PU := 0.000000"
"PROTSEL34","PCT08DO := 60.000000"
"PROTSEL35","PCT08IN := R_TRIG PCT05Q"
"PROTSEL36","PCT02PU := 120.000000"
"PROTSEL37","PCT02DO := 0.000000"
"PROTSEL38","PCT02IN := PCT05Q"
"PROTSEL39","PCT09PU := 0.000000"
"PROTSEL40","PCT09DO := 300.000000"
"PROTSEL41","PCT09IN := R_TRIG PCT02Q"
"PROTSEL42","PSV06 := PCT05Q # UCA HMI STATUS"
"PROTSEL43","# CC2 RCV SER EVENT"
"PROTSEL44","PSV05 := IN107 AND NOT (IN105 OR ASV024)"
"PROTSEL45","# DTT2 298 PUSHBUTTON"
"PROTSEL46","PCT07PU := 0.000000"
"PROTSEL47","PCT07DO := 300.000000"
"PROTSEL48","PCT07IN := R_TRIG PB4 AND ALT07"
"PROTSEL49","PSV08 := PCT07Q # UCA HMI STATUS"
"PROTSEL50","# DTT2 GUARD ALARM ( OFF/TRIP OFF FOR 1 SEC )"
"PROTSEL51","PCT10PU := 60.000000"
"PROTSEL52","PCT10DO := 0.000000"
"PROTSEL53","PCT10IN := NOT IN103 AND NOT IN105"
"PROTSEL54","# LOSS OF IRIG FOR 5 MINUTES"
"PROTSEL55","PCT11PU := 18000.000000"
"PROTSEL56","PCT11DO := 0.000000"
"PROTSEL57","PCT11IN := NOT TIRIG"
"PROTSEL58","# ALARM LOGIC"
"PROTSEL59","PSV20 := IN101 AND NOT LB06 # CC2 LOSS OF POWER ALARM"
"PROTSEL60","PSV21 := IN102 AND NOT LB07 # CC2 COMM PATH FAIL ALARM"
"PROTSEL61","PSV22 := IN103 AND NOT LB08 # CC2 SET FAIL ALARM"
"PROTSEL62","PSV23 := IN104 AND NOT LB09 # CC2 CHECKBACK DISABLED ALARM"
"PROTSEL63","PSV24 := IN101 AND NOT LB11 # DTT2 LOSS OF POWER ALARM"
"PROTSEL64","PSV25 := IN102 AND NOT LB12 # DTT2 TX POWER FAIL ALARM"
"PROTSEL65","PSV26 := PCT10Q AND NOT LB13 # DTT2 LOSS OF GUARD ALARM"
"PROTSEL66","PSV27 := NOT IN104 AND NOT LB14 # DTT2 LOW LEVEL ALARM"
"PROTSEL67","PSV28 := IN107 AND NOT LB15 # DTT 86 TRIP COIL MONITOR ALARM"
"PROTSEL68","PSV29 := IN103 AND NOT LB16 # D60 CRITICAL FAIL ALARM"
"PROTSEL69","PSV30 := LOP AND NOT LB17 # LOSS OF POTENTIAL ALARM"
"PROTSEL70","PSV31 := PCT11Q AND NOT LB18 # LOSS OF IRIG ALARM"
"PROTSEL71","PSV32 := DC1F AND NOT LB19 # DC LEVEL ALARM"
"PROTSEL72","PSV18 := CCIN04 AND NOT LB20 # D60 COMM ALARM"
"PROTSEL73","PSV19 := DC1G AND NOT LB21 # DC GROUND ALARM"
"PROTSEL74","PCT12DO := 0.000000"
"PROTSEL75","PCT12PU := 120.000000"
"PROTSEL76","PCT12IN := IN107 AND NOT LB22"
"PROTSEL77","PSV09 := PCT12Q # CB2 79/551 CR ALARM"
"PROTSEL78","PSV12 := PSV20 OR PSV21 OR PSV22 OR ALT06 # CC ABNORMAL ALARM"
"PROTSEL79","PSV13 := PSV29 OR PSV30 OR PSV09 # RELAY SYS CRITICAL ALARM"
"PROTSEL80","PSV14 := PSV24 OR PSV25 OR PSV26 OR PSV27 OR PSV28 # TT ABNORMAL ALARM"
"PROTSEL81","PSV15 := PSV23 OR PSV31 OR PSV18 # RELAY SYS NONCR ALARM"
"PROTSEL82","PSV16 := PSV19 OR PSV32 # DC ABNORMAL ALARM"
"PROTSEL83","PSV17 := PSV12 OR PSV13 OR PSV14 OR PSV15 OR PSV16 # LINE ALARM"
"PROTSEL84","# ALARM DISPLAY POINT LATCHES"
"PROTSEL85","PLT20S := PSV20"
"PROTSEL86","PLT20R := TRGTR"
"PROTSEL87","PLT21S := PSV21"
"PROTSEL88","PLT21R := TRGTR"
"PROTSEL89","PLT22S := PSV22"
"PROTSEL90","PLT22R := TRGTR"
"PROTSEL91","PLT23S := PSV23"
"PROTSEL92","PLT23R := TRGTR"
"PROTSEL93","PLT24S := PSV24"
"PROTSEL94","PLT24R := TRGTR"
"PROTSEL95","PLT25S := PSV25"
"PROTSEL96","PLT25R := TRGTR"
"PROTSEL97","PLT26S := PSV26"
"PROTSEL98","PLT26R := TRGTR"
"PROTSEL99","PLT27S := PSV27"
"PROTSEL100","PLT27R := TRGTR"
"PROTSEL101","PLT28S := PSV28"
"PROTSEL102","PLT28R := TRGTR"
"PROTSEL103","PLT29S := PSV29"
"PROTSEL104","PLT29R := TRGTR"
"PROTSEL105","PLT30S := PSV30"
"PROTSEL106","PLT30R := TRGTR"
"PROTSEL107","PLT31S := PSV31"
"PROTSEL108","PLT31R := TRGTR"
"PROTSEL109","PLT32S := PSV32"
"PROTSEL110","PLT32R := TRGTR"
"PROTSEL111","PLT18S := PSV18"
"PROTSEL112","PLT18R := TRGTR"
"PROTSEL113","PLT19S := PSV19"
"PROTSEL114","PLT19R := TRGTR"
"PROTSEL115","PLT09S := PSV09"
"PROTSEL116","PLT09R := TRGTR"
"PROTSEL117","PLT17S := IN105 AND NOT IN103"
"PROTSEL118","PLT17R := TRGTR"
"PROTSEL119","# CCS2 SWITCH"
"PROTSEL120","PLT11S := (R_TRIG PB8 OR R_TRIG RB01) AND NOT PLT11"
"PROTSEL121","PLT11R := (R_TRIG PB8 OR R_TRIG RB02) AND PLT11"
"PROTSEL122","PLT10S := R_TRIG RB01"
"PROTSEL123","PLT10R := R_TRIG PB8 OR R_TRIG RB02"
"PROTSEL124","# PHASE UNDERVOLTAGE CC TRIP ELEMENT"
"PROTSEL125","PMV01 := 46.480000 * 3.000000 # VOLT SETTING * PT RATIO/1000"
"PROTSEL126","PSV01 := VABFM <= PMV01 AND 50P4 AND NOT LOP # PHASE 1"
"PROTSEL127","PCT13PU := 2.000000"
"PROTSEL128","PCT13DO := 0.000000"
"PROTSEL129","PCT13IN := PSV01 # PHASE 1 UV TIME DELAY OPERATE"
"PROTSEL130","PSV02 := VBCFM <= PMV01 AND 50P4 AND NOT LOP # PHASE 2"
"PROTSEL131","PCT14PU := 2.000000"
"PROTSEL132","PCT14DO := 0.000000"
"PROTSEL133","PCT14IN := PSV02 # PHASE 2 UV TIME DELAY OPERATE"
"PROTSEL134","PSV03 := VCAFM <= PMV01 AND 50P4 AND NOT LOP # PHASE 3"
"PROTSEL135","PCT15PU := 2.000000"
"PROTSEL136","PCT15DO := 0.000000"
"PROTSEL137","PCT15IN := PSV03 # PHASE 3 UV TIME DELAY OPERATE"
"PROTSEL138","# NUETRAL OVERVOLTAGE CC TRIP ELEMENT"
